@using TKWone.Models

@{
    ViewBag.Title = "CheckOut";
}

<section style="background-color: #D2B48C; ">

    <h2>Check Out Shopping Cart</h2>
    @if (Session["Cart"] != null)
    {
        <table class="table">
            <tr>
                <td>Name</td>
                <td>Quantity</td>
                <td>Price</td>
                <td>Sub Total</td>
            </tr>
            @foreach (var cart in (List<lamlaif.Models.Cart>)Session["Cart"])
            {
                double p = Convert.ToDouble(cart.Product.ProPrice);
                int q = Convert.ToInt32(cart.Quantity);
                double subtotal = p * q;
                <tr>
                    <td>@cart.Product.ProName</td>
                    <td>@cart.Quantity</td>
                    <td>@Html.FormatValue(cart.Product.ProPrice, "{0:C}")</td>
                    <td>@Html.FormatValue(subtotal, "{0:C}")</td>
                </tr>
            }
            <tr>
                @{
                    List<lamlaif.Models.Cart> temp = (List<lamlaif.Models.Cart>)Session["Cart"];
                    var total = temp.Sum(x => x.Quantity * x.Product.ProPrice);
                }
                <td colspan="2">
                    &nbsp;
                </td>
                <td align="right">Total:</td>
                <td>
                    @Html.FormatValue(total, "{0:C}")
                </td>
            </tr>
        </table>
    }

    <h3>Customer's Information</h3>
    @using (Html.BeginForm("ProcessOrder", "ShoppingCart", FormMethod.Post, new { id = "customer-form" }))
    {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <hr />
            <div class="form-group">
                <label class="control-label col-md-2">Customer's Name</label>
                <div class="col-md-10">
                    <input type="text" name="cusName" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-2">Customer's Phone</label>
                <div class="col-md-10">
                    <input type="text" name="cusPhone" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-2">Customer's Email</label>
                <div class="col-md-10">
                    <input type="text" name="cusEmail" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-md-2">Customer's Address</label>
                <div class="col-md-10">
                    <input type="text" name="cusAddress" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Process Order" class="btn btn-default" />
                </div>
            </div>
        </div>
    }

</section>